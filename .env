DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=secret123
DB_NAME=mydb
DB_PORT=5432
DB_SSLMODE=disable
DB_TIMEZONE=Europe/Moscow
SESSION_SECRET=your-very-secure-secret-key-here
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioaccesskey
MINIO_SECRET_KEY=miniosecretkey
MINIO_BUCKET=orders
MINIO_USE_SSL=false
MAX_FILE_SIZE=10485760  # Максимальный размер файла в байтах (10MB, по умолчанию)
MAX_FILES_PER_REQUEST=5 # Максимальное количество файлов в одном запросе
BCRYPT_COST=12